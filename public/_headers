# Security headers for every response.
# Each header is declared in exactly one rule. Cloudflare joins duplicate
# header values with a comma, so repeating one here would corrupt it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-3swV7pI3GPKLRfNyMJ/iZXscQesdAs5xN0b3EhaL768=' 'sha256-5MYmXr6IqIgaYF4bo2+KSJSv46RFZm/d7VJZb29oLo8='


# Astro fingerprints everything in /_astro, so these URLs change whenever their
# contents do and can be cached indefinitely in the browser.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
