# Security headers for every response.
# Each header is declared in exactly one rule. Cloudflare joins duplicate
# header values with a comma, so repeating one here would corrupt it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-3swV7pI3GPKLRfNyMJ/iZXscQesdAs5xN0b3EhaL768=' 'sha256-lN5kXdz32QigubHI8WO1c/YUNO2OIAwafBZvczmRVO4=' 'sha256-LRFpTj3eXVaYLeMqX97lKrwaaH12jIczyJ60Br/brps='