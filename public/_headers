# Security headers for every response.
# Each header is declared in exactly one rule. Cloudflare joins duplicate
# header values with a comma, so repeating one here would corrupt it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'sha256-DW66IWUaeb6nHnwu8QSGHBvgJheRyyPl7BxSsakA9RU=' 'sha256-LRFpTj3eXVaYLeMqX97lKrwaaH12jIczyJ60Br/brps=' 'sha256-bWEeEmOECFUZT5U9IyC45VX/88UPEtP7zlwxNTZcjRA='