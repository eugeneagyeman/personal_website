---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Personal website and portfolio of a software engineer." } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Raleway:wght@700&display=swap" rel="stylesheet">

    <!-- Theme Initialization Script (Prevents Flash) -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
	</head>
	<body class="bg-electric dark:bg-black print:bg-white text-white dark:text-slate-200 min-h-screen flex flex-col font-sans antialiased selection:bg-white/30 selection:text-white">
    <Header />

		<main class="flex-grow pt-20">
			<slot />
		</main>

    <footer class="site-footer border-t border-white/20 dark:border-white/5 bg-electric dark:bg-black py-12 transition-colors duration-300">
      <div class="max-w-4xl mx-auto px-4 text-center text-white/85 dark:text-slate-500 text-sm font-bold">
        &copy; {new Date().getFullYear()} Eugene Agyeman. Built with ❤️ from London, 🇬🇧
      </div>
    </footer>
	</body>
</html>
