---
import Layout from '../layouts/Layout.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
}

const { title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});
---

<Layout title={title} description={description}>
	<article class="doc">
		<header class="space-y-6">
			<h1>{title}</h1>
			<p class="text-label uppercase text-muted">
				<time datetime={pubDate.toISOString()}>{formattedDate}</time> · Thoughts
			</p>
			<p class="text-muted">{description}</p>
			<hr class="border-0 border-t border-dashed border-line" />
		</header>

		<div class="doc-prose mt-12">
			<slot />
		</div>
	</article>
</Layout>
