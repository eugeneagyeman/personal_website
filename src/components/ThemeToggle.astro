---
import { THEME_STORAGE_KEY, THEME_IDS } from '../lib/theme.mjs';
---

<!-- The label names the action: it offers the theme you are not in. Both labels
     are in the markup and CSS (global.css) shows one, so there is no flash. -->
<button
  id={THEME_IDS.toggle}
  type="button"
  class="bracket cursor-pointer text-muted hover:text-fg transition-colors"
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <span class="theme-offer-dark">Dark</span><span class="theme-offer-light">Light</span>
</button>

<script define:vars={{ THEME_STORAGE_KEY, THEME_IDS }}>
  const themeToggleBtn = document.getElementById(THEME_IDS.toggle);

  const syncPressed = () =>
    themeToggleBtn?.setAttribute(
      'aria-pressed',
      String(document.documentElement.classList.contains('dark')),
    );

  syncPressed();

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem(THEME_STORAGE_KEY, isDark ? 'dark' : 'light');
    syncPressed();
  });
</script>
