<button
  id="theme-toggle"
  type="button"
  class="text-white/95 dark:text-slate-400 hover:text-white dark:hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-white/30 dark:focus:ring-slate-700 rounded-lg text-sm p-2.5"
  aria-label="Toggle Dark Mode"
>
  <!-- Sun Icon (Hidden in Dark Mode) -->
  <svg
    id="theme-toggle-light-icon"
    class="w-5 h-5 hidden dark:block"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      fill-rule="evenodd"
      clip-rule="evenodd"></path>
  </svg>
  <!-- Moon Icon (Hidden in Light Mode) -->
  <svg
    id="theme-toggle-dark-icon"
    class="w-5 h-5 block dark:hidden"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    ></path>
  </svg>
</button>

<script>
  const themeToggleBtn = document.getElementById('theme-toggle');

  themeToggleBtn?.addEventListener('click', () => {
    // toggle icons inside button
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');

    if (!isDark) {
      const palette = (document.documentElement.dataset.palette || '')
        .split(',')
        .filter(Boolean);
      const colour = palette[Math.floor(Math.random() * palette.length)];
      if (colour) {
        document.documentElement.style.setProperty('--color-electric', colour);
        sessionStorage.setItem('theme-colour', colour);
      }
    }
  });
</script>
