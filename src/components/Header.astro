---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Me' },
  { href: '/blog', label: 'Thoughts' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header fixed top-0 w-full z-50 bg-electric/90 dark:bg-slate-950/90 border-b border-white/20 dark:border-white/5 transition-all duration-300 backdrop-blur-sm">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="text-2xl font-bold tracking-wide font-display text-white dark:text-white hover:text-white/85 dark:hover:text-slate-300 transition-colors">
        Eugene Agyeman
      </a>

      <!-- Navigation -->
      <div class="flex items-center gap-6">
        <nav class="hidden md:flex space-x-8">
          {links.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-white/80 dark:text-slate-400 hover:text-white dark:hover:text-white transition-colors duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <ThemeToggle />
      </div>

      <!-- Mobile Menu (Placeholder) -->
      <div class="md:hidden ml-4">
        <button class="text-white/80 dark:text-slate-400 hover:text-white dark:hover:text-white">
          <span class="sr-only">Open menu</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
