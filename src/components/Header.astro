---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../lib/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Thoughts' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header shell pt-10">
  <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
    <a href="/" class="block uppercase" aria-label={`${site.name}, home`}>
      <span class="block text-lead font-bold">{site.name} <span aria-hidden="true">█</span></span>
      <span class="block text-body text-muted">Software engineer</span>
    </a>

    <div class="flex flex-col items-start md:items-end text-label uppercase">
      <nav aria-label="Primary" class="bracket">
        <ul class="inline">
          {links.map((link) => (
            <li class="inline nav-item">
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="navlink"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
