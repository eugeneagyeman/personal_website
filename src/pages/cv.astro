---
import Layout from '../layouts/Layout.astro';

const email = 'eugene.agyeman1@yahoo.co.uk';
const linkedin = 'https://www.linkedin.com/in/eugene-agyeman';

const experience = [
	{
		role: 'Full Stack Software Engineer, Real-Time Operations',
		company: 'Axon',
		location: 'London, United Kingdom',
		period: 'Apr 2023 – Present',
		highlights: [
			'Own the rules domain end-to-end within Axon’s Real-Time Alerts platform, spanning data modelling, APIs, real-time evaluation, operator tooling, and cloud operations for a platform available to approximately 20,000 agencies and more than 1 million users globally.',
			'Built a low-latency rule engine in Go that evaluates real-time events against agency-defined alert rules across a platform processing more than 400 million events annually, applying role, proximity, and permission conditions while delivering alerts with p99 latency under 1.5 seconds.',
			'Designed the rules data model and REST APIs and built the operator-facing Rule Editor in Angular, providing end-to-end lifecycle management for creating, updating, enabling, disabling, and deleting alert rules.',
			'Provision and operate cloud-native services on AKS using Terraform, Helm, ArgoCD, and Istio, with gRPC/Protobuf for inter-service communication, maintaining 99.99% availability for the rules domain.',
			'Mentor junior engineers through system design, code reviews, debugging, and implementation, helping them take ownership of production services and reinforcing team engineering standards.',
			'Use Cursor, Claude, and Codex to accelerate repository-wide implementation, refactoring, test generation, debugging, and code review, validating generated changes through automated testing and peer review.',
		],
	},
	{
		role: 'Software Engineer',
		company: 'Digital Shadows',
		location: 'London, United Kingdom',
		period: 'Nov 2021 – Nov 2022',
		highlights: [
			'Designed, built, and deployed a Java/Spring service to production within four months, processing more than 1 million social-platform messages to identify customer-exposed sensitive data, including payment card information and confidential files.',
			'Built automated detection and triage workflows that surfaced high-confidence exposures to customers for investigation and streamlined downstream takedown requests.',
			'Implemented the event-driven service using Spring, RabbitMQ, and Docker and provisioned its AWS infrastructure, including S3 and EC2, using Terraform.',
		],
	},
	{
		role: 'Software Engineering Intern',
		company: 'NatWest Markets',
		location: 'London, United Kingdom',
		period: 'Jun 2019 – Sep 2019',
		highlights: [
			'Built and shipped a production system mapping 75% of logical and physical data flows across NatWest Markets’ application estate.',
			'Presented the system and findings to senior leadership, including the CTO.',
		],
	},
];

const projects = [
	{
		name: 'Evaluating Language Models for Frame Identification in News Articles',
		stack: 'Python, PyTorch, Scikit-Learn, NumPy, Pandas, Hugging Face',
		period: 'Jun 2020 – Jun 2021',
		highlights: [
			'Built two NLP models using Aspect-Based Sentiment Analysis to identify media frames in news articles, achieving a 10% improvement in precision and recall over the state of the art at the time.',
			'Submitted findings for publication, contributing to research in automated frame identification.',
		],
	},
];

const skillGroups = [
	{
		label: 'Languages',
		items: ['Go', 'Java', 'TypeScript', 'Python', 'SQL', 'C/C++', 'Bash'],
	},
	{
		label: 'Backend & Distributed Systems',
		items: ['gRPC/Protobuf', 'Spring', 'RabbitMQ', 'REST APIs', 'Kafka'],
	},
	{
		label: 'Infrastructure & Observability',
		items: [
			'Kubernetes (AKS)',
			'Terraform',
			'Docker',
			'Azure',
			'AWS (S3/EC2)',
			'Helm',
			'Istio',
			'ArgoCD',
			'Prometheus',
			'Grafana',
			'Splunk',
		],
	},
	{ label: 'Frontend', items: ['Angular'] },
	{ label: 'AI-Assisted Engineering', items: ['Cursor', 'Claude', 'Codex'] },
];
---

<Layout
	title="CV | Eugene Agyeman"
	description="Curriculum vitae of Eugene Agyeman, a software engineer specialising in real-time distributed systems, Go, and cloud infrastructure."
>
	<div class="max-w-5xl mx-auto px-4 sm:px-6 py-14 print:max-w-none print:p-0">
		<div class="flex flex-wrap items-end justify-between gap-6 mb-10 print:hidden">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/80 dark:text-cyan-500">
				Curriculum Vitae
			</p>
			<a
				href="/eugene-agyeman-cv.pdf"
				download="eugene-agyeman-cv.pdf"
				class="inline-flex items-center gap-2 rounded-full bg-white dark:bg-white px-5 py-2.5 text-sm font-medium text-electric-deep dark:text-slate-900 hover:bg-white/85 dark:hover:bg-slate-200 transition-colors"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
					><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg
				>
				Download PDF
			</a>
		</div>

		<article
			class="cv-paper rounded-2xl bg-white text-slate-900 shadow-xl ring-1 ring-slate-900/5 print:rounded-none print:shadow-none print:ring-0"
		>
			<header class="border-b border-slate-200 p-8 sm:p-10 print:p-0">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
					<div>
					<h1 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight">
						Eugene Agyeman
					</h1>
						<p class="mt-1 text-lg font-medium text-slate-600">Software Engineer</p>
						<p class="text-sm text-slate-500 mt-1">London, United Kingdom</p>
					</div>
					<div class="sm:text-right text-sm space-y-1">
						<a
							href={`mailto:${email}`}
							class="block text-slate-700 hover:text-cyan-700 transition-colors break-all"
							>{email}</a
						>
						<a
							href={linkedin}
							rel="noopener noreferrer"
							target="_blank"
							class="block text-slate-700 hover:text-cyan-700 transition-colors"
							>linkedin.com/in/eugene-agyeman</a
						>
					</div>
				</div>
			</header>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-x-10 gap-y-12 p-8 sm:p-10 print:grid-cols-3 print:gap-x-8 print:p-0">
				<div class="lg:col-span-2 space-y-10">
					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Experience
						</h2>

						<div class="space-y-8">
							{
								experience.map((job) => (
									<div class="relative pl-5 before:absolute before:left-0 before:top-1.5 before:h-2 before:w-2 before:rounded-full before:bg-cyan-500 print:before:bg-slate-400">
										<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
											<h3 class="text-lg font-bold text-slate-900">{job.role}</h3>
											<span class="text-sm font-medium text-slate-500 tabular-nums whitespace-nowrap">
												{job.period}
											</span>
										</div>
										<p class="mt-0.5 text-sm font-semibold text-cyan-700">
											{job.company} <span class="font-normal text-slate-500">· {job.location}</span>
										</p>
										<ul class="mt-3 space-y-1.5 text-sm text-slate-600 leading-relaxed list-disc list-outside ml-4">
											{job.highlights.map((point) => (
												<li>{point}</li>
											))}
										</ul>
									</div>
								))
							}
						</div>
					</section>

					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Projects
						</h2>

						{
							projects.map((project) => (
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
										<h3 class="font-bold text-slate-900">{project.name}</h3>
										<span class="text-sm font-medium text-slate-500 tabular-nums whitespace-nowrap">
											{project.period}
										</span>
									</div>
									<p class="mt-0.5 text-sm text-slate-500">{project.stack}</p>
									<ul class="mt-3 space-y-1.5 text-sm text-slate-600 leading-relaxed list-disc list-outside ml-4">
										{project.highlights.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								</div>
							))
						}
					</section>
				</div>

				<div class="space-y-10">
					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Technical Skills
						</h2>

						<div class="space-y-4">
							{
								skillGroups.map((group) => (
									<div>
										<h3 class="text-xs font-semibold text-slate-800 mb-2">{group.label}</h3>
										<div class="flex flex-wrap gap-1.5">
											{group.items.map((item) => (
												<span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-xs font-medium">
													{item}
												</span>
											))}
										</div>
									</div>
								))
							}
						</div>
					</section>

					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Education
						</h2>
						<div>
							<h3 class="font-bold text-slate-900">University of Southampton</h3>
							<p class="text-sm text-slate-600 mt-0.5">BSc Computer Science</p>
							<p class="text-sm text-slate-500">Upper Second Class Honours</p>
							<p class="text-sm text-slate-500 mt-1 tabular-nums">Sep 2016 – Jun 2021</p>
						</div>
					</section>
				</div>
			</div>
		</article>
	</div>

	<style is:global>
		article.cv-paper ::selection {
			background-color: var(--color-cyan-100);
			color: var(--color-cyan-950);
		}

		@media print {
			body {
				margin: 0;
				padding: 0;
				background: white;
				-webkit-print-color-adjust: exact;
			}

			.site-header,
			.site-footer,
			nav,
			.print\:hidden {
				display: none !important;
			}
		}
	</style>
</Layout>
