---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { site } from '../lib/site';

// Data lives in src/data/cv.json behind the schema'd `cv` collection (see
// content.config.ts); this page is only its renderer.
const entry = await getEntry('cv', 'main');
if (!entry) throw new Error('CV entry "main" missing from src/data/cv.json');
const { headline, experience, projects, skillGroups, education } = entry.data;
---

<Layout
	title="CV | Eugene Agyeman"
	description="Curriculum vitae of Eugene Agyeman, a software engineer specialising in real-time distributed systems, Go, and cloud infrastructure."
>
	<div class="cv">
		<div class="flex flex-wrap items-center justify-between gap-4 mb-12 print:hidden">
			<p class="font-bold uppercase">Curriculum Vitae</p>
			<a
				href="/eugene-agyeman-cv.pdf"
				download="eugene-agyeman-cv.pdf"
				class="inline-block rounded-lg bg-fg px-4 py-2.5 text-label font-bold uppercase text-bg hover:opacity-85 transition-opacity"
			>
				Download PDF
			</a>
		</div>

		<article>
			<header class="cv-header flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between pb-6 border-b border-dashed border-line">
				<div>
					<h1>{site.name}</h1>
					<p class="mt-1">{headline}</p>
					<p class="text-muted">{site.location}</p>
				</div>
				<div class="sm:text-right space-y-1 break-all">
					<a href={`mailto:${site.cvEmail}`} class="link block">{site.cvEmail}</a>
					<a
						href={site.links.linkedin}
						rel="noopener noreferrer"
						target="_blank"
						class="link block"
					>linkedin.com/in/eugene-agyeman</a>
				</div>
			</header>

			<div class="cv-grid grid grid-cols-1 gap-x-10 gap-y-12 pt-12 lg:grid-cols-3">
				<div class="lg:col-span-2 space-y-12">
					<section>
						<h2 class="cv-h2">Experience</h2>
						<div class="space-y-8">
							{
								experience.map((job) => (
									<div class="cv-entry">
										<div class="flex flex-wrap items-baseline justify-between gap-x-4">
											<h3>{job.role}</h3>
											<span class="text-muted whitespace-nowrap">
												<time datetime={job.start.iso}>{job.start.label}</time>
												{' – '}
												{job.end ? <time datetime={job.end.iso}>{job.end.label}</time> : 'Present'}
											</span>
										</div>
										<p class="font-medium">
											{job.company} <span class="font-normal text-muted">· {job.location}</span>
										</p>
										<ul class="cv-bullets mt-3 space-y-1.5">
											{job.highlights.map((point) => (
												<li>{point}</li>
											))}
										</ul>
									</div>
								))
							}
						</div>
					</section>

					<section>
						<h2 class="cv-h2">Projects</h2>
						<div class="space-y-8">
							{
								projects.map((project) => (
									<div class="cv-entry">
										<div class="flex flex-wrap items-baseline justify-between gap-x-4">
											<h3 class="normal-case">{project.name}</h3>
											<span class="text-muted whitespace-nowrap">
												<time datetime={project.start.iso}>{project.start.label}</time>
												{' – '}
												{project.end ? (
													<time datetime={project.end.iso}>{project.end.label}</time>
												) : (
													'Present'
												)}
											</span>
										</div>
										<p class="text-muted">{project.stack}</p>
										<ul class="cv-bullets mt-3 space-y-1.5">
											{project.highlights.map((point) => (
												<li>{point}</li>
											))}
										</ul>
									</div>
								))
							}
						</div>
					</section>
				</div>

				<div class="space-y-12">
					<section>
						<h2 class="cv-h2">Technical Skills</h2>
						<dl class="space-y-4">
							{
								skillGroups.map((group) => (
									<div class="cv-entry">
										<dt class="font-bold">{group.label}</dt>
										<dd class="text-muted">{group.items.join(', ')}</dd>
									</div>
								))
							}
						</dl>
					</section>

					<section>
						<h2 class="cv-h2">Education</h2>
						<div class="space-y-4">
							{
								education.map((school) => (
									<div class="cv-entry">
										<h3 class="normal-case">{school.institution}</h3>
										<p>{school.degree}</p>
										{school.status && <p class="text-muted">{school.status}</p>}
										{school.honours && <p class="text-muted">{school.honours}</p>}
										<p class="text-muted">
											<time datetime={school.start.iso}>{school.start.label}</time> – <time datetime={school.end.iso}>{school.end.label}</time>
										</p>
									</div>
								))
							}
						</div>
					</section>
				</div>
			</div>
		</article>
	</div>

	<style is:global>
		/* Section heading inside the document: rule underneath, like a spec sheet. */
		.cv-h2 {
			padding-bottom: 8px;
			margin-bottom: 24px;
			border-bottom: 1px dashed var(--line);
		}

		.cv-bullets > li {
			padding-left: 2ch;
			text-indent: -2ch;
		}

		.cv-bullets > li::before {
			content: "- ";
			color: var(--muted);
		}

		@media print {
			@page {
				size: A4;
				margin: 12mm;
			}

			html,
			body {
				background: #fff !important;
				color: #000;
				font-size: 8.5pt;
				line-height: 1.3;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}
			.site-header,
			.site-footer,
			.print\:hidden {
				display: none !important;
			}

			.cv-header {
				flex-direction: row !important;
				padding-bottom: 8pt;
				border-bottom-style: solid;
			}

			.cv-header > div:last-child {
				text-align: right;
			}

			.cv-grid {
				grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
				column-gap: 18pt !important;
				row-gap: 0 !important;
				padding-top: 12pt !important;
			}

			.cv-grid > div:first-child {
				grid-column: span 2 / span 2;
			}

			/* Headings are pinned to the body step on screen; on paper they follow
			   the 8.5pt body like everything else. */
			h1,
			h2,
			h3 {
				font-size: inherit;
				line-height: inherit;
			}

			.cv-h2 {
				break-after: avoid;
				border-bottom-style: solid;
				margin-bottom: 8pt;
				padding-bottom: 4pt;
			}

			.cv-entry {
				break-inside: avoid;
			}

			.cv-bullets {
				margin-top: 4pt !important;
			}

			.cv-bullets > li {
				margin-top: 2pt;
			}

			a {
				color: #000;
				text-decoration: none;
			}
		}
	</style>
</Layout>
