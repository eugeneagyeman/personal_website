---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { site } from '../lib/site';

// Data lives in src/data/cv.json behind the schema'd `cv` collection (see
// content.config.ts); this page is only its renderer.
const entry = await getEntry('cv', 'main');
if (!entry) throw new Error('CV entry "main" missing from src/data/cv.json');
const { experience, projects, skillGroups, education } = entry.data;
---

<Layout
	title="CV | Eugene Agyeman"
	description="Curriculum vitae of Eugene Agyeman, a software engineer specialising in real-time distributed systems, Go, and cloud infrastructure."
>
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 print:max-w-none print:p-0">
		<div class="flex flex-wrap items-center justify-between gap-6 mb-10 print:hidden">
			<p class="text-2xl font-bold tracking-tight text-white dark:text-cyan-400">
				Curriculum Vitae
			</p>
			<a
				href="/eugene-agyeman-cv.pdf"
				download="eugene-agyeman-cv.pdf"
				class="inline-flex items-center gap-2 rounded-full border border-white/60 px-5 py-2.5 text-sm font-medium text-white hover:bg-white/10 transition-colors"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
					><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
						d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg
				>
				Download PDF
			</a>
		</div>

		<article
			class="cv-paper rounded-2xl bg-white text-slate-900 shadow-xl ring-1 ring-slate-900/5 print:rounded-none print:shadow-none print:ring-0"
		>
			<header class="border-b border-slate-200 p-8 sm:p-10 print:p-0">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
					<div>
					<h1 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight">
						{site.name}
					</h1>
						<p class="mt-1 text-lg font-medium text-slate-600">Senior Software Engineer</p>
						<p class="text-sm text-slate-500 mt-1">{site.location}</p>
					</div>
					<div class="sm:text-right text-sm space-y-1">
						<a
							href={`mailto:${site.cvEmail}`}
							class="block text-slate-700 hover:text-cyan-700 transition-colors break-all"
							>{site.cvEmail}</a
						>
						<a
							href={site.links.linkedin}
							rel="noopener noreferrer"
							target="_blank"
							class="block text-slate-700 hover:text-cyan-700 transition-colors"
							>linkedin.com/in/eugene-agyeman</a
						>
					</div>
				</div>
			</header>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-x-10 gap-y-12 p-8 sm:p-10 print:grid-cols-3 print:gap-x-8 print:p-0">
				<div class="lg:col-span-2 space-y-10">
					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Experience
						</h2>

						<div class="space-y-8">
							{
								experience.map((job) => (
									<div class="relative pl-5 before:absolute before:left-0 before:top-2.5 before:h-2 before:w-2 before:rounded-full before:bg-cyan-500 print:before:bg-slate-400">
										<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
											<h3 class="text-lg font-bold text-slate-900">{job.role}</h3>
										<span class="text-sm font-medium text-slate-500 tabular-nums whitespace-nowrap">
											<time datetime={job.start.iso}>{job.start.label}</time>
											{' – '}
											{job.end ? <time datetime={job.end.iso}>{job.end.label}</time> : 'Present'}
										</span>
										</div>
										<p class="mt-0.5 text-sm font-semibold text-cyan-700">
											{job.company} <span class="font-normal text-slate-500">· {job.location}</span>
										</p>
										<ul class="mt-3 space-y-1.5 text-sm text-slate-600 leading-relaxed list-disc list-outside ml-4">
											{job.highlights.map((point) => (
												<li>{point}</li>
											))}
										</ul>
									</div>
								))
							}
						</div>
					</section>

					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Projects
						</h2>

						{
							projects.map((project) => (
								<div>
									<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
										<h3 class="font-bold text-slate-900">{project.name}</h3>
									<span class="text-sm font-medium text-slate-500 tabular-nums whitespace-nowrap">
										<time datetime={project.start.iso}>{project.start.label}</time>
										{' – '}
										{project.end ? (
											<time datetime={project.end.iso}>{project.end.label}</time>
										) : (
											'Present'
										)}
									</span>
									</div>
									<p class="mt-0.5 text-sm text-slate-500">{project.stack}</p>
									<ul class="mt-3 space-y-1.5 text-sm text-slate-600 leading-relaxed list-disc list-outside ml-4">
										{project.highlights.map((point) => (
											<li>{point}</li>
										))}
									</ul>
								</div>
							))
						}
					</section>
				</div>

				<div class="space-y-10">
					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Technical Skills
						</h2>

						<div class="space-y-4">
							{
								skillGroups.map((group) => (
									<div>
										<h3 class="text-xs font-semibold text-slate-800 mb-2">{group.label}</h3>
										<div class="flex flex-wrap gap-1.5">
											{group.items.map((item) => (
												<span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-xs font-medium">
													{item}
												</span>
											))}
										</div>
									</div>
								))
							}
						</div>
					</section>

					<section>
						<h2
							class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 border-b border-slate-200 pb-2 mb-5"
						>
							Education
						</h2>
						<div>
							<h3 class="font-bold text-slate-900">{education.institution}</h3>
							<p class="text-sm text-slate-600 mt-0.5">{education.degree}</p>
							<p class="text-sm text-slate-500">{education.honours}</p>
							<p class="text-sm text-slate-500 mt-1 tabular-nums">
								<time datetime={education.start.iso}>{education.start.label}</time> – <time datetime={education.end.iso}>{education.end.label}</time>
							</p>
						</div>
					</section>
				</div>
			</div>
		</article>
	</div>

	<style is:global>
		article.cv-paper ::selection {
			background-color: var(--color-cyan-100);
			color: var(--color-cyan-950);
		}

		@media print {
			body {
				margin: 0;
				padding: 0;
				background: white;
				-webkit-print-color-adjust: exact;
			}

			.site-header,
			.site-footer,
			nav,
			.print\:hidden {
				display: none !important;
			}
		}
	</style>
</Layout>

