---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import hero from "../assets/hero.jpg";
---

<Layout title="Eugene Agyeman | Software Engineer">
  <div
    class="grid gap-x-20 gap-y-12 lg:grid-cols-[minmax(0,560px)_minmax(0,1fr)] lg:grid-rows-[auto_1fr]"
  >
    <div class="space-y-6">
      <h1 class="text-display">
        Hey, I'm Eugene.<br />
        I love computers. Probably too much.
      </h1>
      <p class="text-lead">
        Software engineer in London. I look after the rules engine behind
        Axon's real-time alerts, mostly in Go, and make sure it doesn't fall
        over.
      </p>
    </div>

    {
      /* Density-based srcset: the fallback `src` is the 300px-wide 1x image
        (~20KB) instead of the full 1536px original (~343KB) that `widths`
        would emit, so non-srcset clients stop paying for pixels the CSS
        never displays. The figure sits beside the intro at lg and follows it
        on narrower screens. */
    }
    <figure
      class="lg:row-span-2 lg:row-start-1 lg:col-start-2 w-full max-w-[360px] lg:justify-self-start"
    >
      <div class="border border-dashed border-line p-3">
        <Image
          src={hero}
          alt="Eugene at a viewpoint above a lake"
          width={300}
          densities={[1, 1.5, 2]}
          loading="eager"
          fetchpriority="high"
          class="w-full aspect-[3/4] object-cover"
        />
      </div>
    </figure>

    <div class="space-y-6 lg:col-start-1">
      <div>
        <p>Elsewhere:</p>
        <ul class="mt-2">
          <li>
            <span class="text-muted" aria-hidden="true">* </span><a
              href="/about"
              class="link">More about me -&gt;</a
            >
          </li>
          <li>
            <span class="text-muted" aria-hidden="true">* </span><a
              href="/cv"
              class="link">Read the CV -&gt;</a
            >
          </li>
          <li>
            <span class="text-muted" aria-hidden="true">* </span><a
              href="/contact"
              class="link">Get in touch -&gt;</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
