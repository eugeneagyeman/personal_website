---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page not found | Eugene Agyeman"
	description="That page does not exist."
>
	<div class="doc flow">
		<h1>That page isn't here</h1>

		<p>
			The link may be out of date, or the page may have moved. The rest of the site is
			still where you left it. (Error 404.)
		</p>

		<p class="flex flex-wrap gap-x-6 gap-y-2">
			<a href="/" class="link bracket">Back home</a>
			<a href="/contact" class="link bracket">Report a broken link</a>
		</p>
	</div>
</Layout>
