---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page not found | Eugene Agyeman"
	description="That page does not exist."
>
	<section class="max-w-4xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
		<div class="flex flex-col items-center text-center">
			<p
				class="text-7xl sm:text-8xl font-extrabold text-white dark:text-slate-200 tracking-tight tabular-nums"
				aria-hidden="true"
			>
				404
			</p>

			<h1 class="mt-6 text-3xl sm:text-4xl font-extrabold text-white dark:text-white tracking-tight">
				That page isn't here
			</h1>

			<p class="mt-4 text-lg text-white/90 dark:text-slate-400 max-w-md leading-relaxed">
				The link may be out of date, or the page may have moved. The rest of the site is
				still where you left it.
			</p>

			<div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
				<a
					href="/"
					class="inline-flex items-center rounded-full bg-white text-electric-deep dark:bg-slate-100 dark:text-slate-900 px-5 py-2.5 text-sm font-medium hover:bg-white/85 dark:hover:bg-white transition-colors"
				>
					Back to the home page
				</a>
				<a href="/contact" class="text-sm text-white/95 hover:text-white dark:text-slate-400 dark:hover:text-white transition-colors">
					Report a broken link
				</a>
			</div>
		</div>
	</section>
</Layout>
