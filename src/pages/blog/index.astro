---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Thoughts | Eugene Agyeman"
	description="Occasional writing from Eugene Agyeman, a software engineer in London. Coming soon."
>
	<section class="max-w-4xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
		<div class="flex flex-col items-center text-center">
			<svg
				viewBox="0 0 160 96"
				fill="none"
				aria-hidden="true"
				class="w-40 sm:w-48 h-auto text-white dark:text-slate-200"
			>
				<defs>
					<clipPath id="roadwork-plank">
						<rect x="16" y="32" width="128" height="22" rx="5" />
					</clipPath>
				</defs>
				<rect x="26" y="50" width="9" height="40" rx="3" fill="currentColor" opacity="0.5" />
				<rect x="125" y="50" width="9" height="40" rx="3" fill="currentColor" opacity="0.5" />
				<rect x="16" y="32" width="128" height="22" rx="5" fill="currentColor" />
				<g clip-path="url(#roadwork-plank)" fill="#0000f2">
					<g transform="rotate(-45 80 43)">
						<rect x="-120" y="-80" width="12" height="400" />
						<rect x="-96" y="-80" width="12" height="400" />
						<rect x="-72" y="-80" width="12" height="400" />
						<rect x="-48" y="-80" width="12" height="400" />
						<rect x="-24" y="-80" width="12" height="400" />
						<rect x="0" y="-80" width="12" height="400" />
						<rect x="24" y="-80" width="12" height="400" />
						<rect x="48" y="-80" width="12" height="400" />
						<rect x="72" y="-80" width="12" height="400" />
						<rect x="96" y="-80" width="12" height="400" />
						<rect x="120" y="-80" width="12" height="400" />
						<rect x="144" y="-80" width="12" height="400" />
						<rect x="168" y="-80" width="12" height="400" />
					</g>
				</g>
			</svg>

			<h1 class="mt-10 text-3xl sm:text-4xl font-extrabold text-white dark:text-white tracking-tight">
				Under construction
			</h1>

			<p class="mt-4 text-lg text-white/90 dark:text-slate-400 max-w-md leading-relaxed">
				Nothing published here yet. I'm working on it, so check back later.
			</p>
		</div>
	</section>
</Layout>
