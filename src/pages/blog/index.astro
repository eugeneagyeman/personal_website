---
import Layout from '../../layouts/Layout.astro';

// Decorative sign; the paragraph below carries the meaning, so it is hidden
// from assistive tech.
const sign = [
	'+----------------------------+',
	'|                            |',
	'|     UNDER CONSTRUCTION     |',
	'|                            |',
	'+----------------------------+',
].join('\n');
---

<Layout
	title="Thoughts | Eugene Agyeman"
	description="Occasional writing from Eugene Agyeman, a software engineer in London. Coming soon."
>
	<div class="doc flow">
		<h1>Thoughts</h1>

		<div class="ascii-wrap" aria-hidden="true">
			<pre class="ascii">{sign}</pre>
		</div>

		<p>Nothing published here yet. I'm working on it, so check back later.</p>
	</div>
</Layout>
