---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';

const channels = [
	{
		label: 'Email',
		value: site.email,
		href: `mailto:${site.email}`,
		note: 'Best way to reach me',
	},
	{
		label: 'LinkedIn',
		value: 'linkedin.com/in/eugene-agyeman',
		href: site.links.linkedin,
		note: 'Work and experience',
	},
	{
		label: 'GitHub',
		value: 'github.com/eugeneagyeman',
		href: site.links.github,
		note: 'Side projects and experiments',
	},
];
---

<Layout
	title="Contact | Eugene Agyeman"
	description="Get in touch with Eugene Agyeman, a software engineer in London. Email, LinkedIn, and GitHub."
>
	<div class="doc flow">
		<h1>My inbox is open.</h1>
		<p>
			Questions, half-formed ideas, or just a chat about technology. I read everything that
			comes in.
		</p>
	</div>

	{/* Email is the preferred channel, so it spans the full row above the two profiles. */}
	<ul class="mt-12 grid gap-4 sm:grid-cols-2 max-w-[820px]">
		{
			channels.map((channel, i) => {
				const external = channel.href.startsWith('http');
				return (
					<li class={i === 0 ? 'sm:col-span-2' : undefined}>
						<a
							href={channel.href}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
							class="panel group block h-full"
						>
							<span class="chip">{channel.label}</span>
							<span class="mt-3 block break-words font-medium text-link group-hover:underline underline-offset-[3px]">
								{channel.value} <span aria-hidden="true">-&gt;</span>
							</span>
							<span class="mt-1 block text-muted">{channel.note}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</Layout>
