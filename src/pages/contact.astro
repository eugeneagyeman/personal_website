---
import Layout from '../layouts/Layout.astro';

const email = 'hi@eugeneagyeman.io';

const channels = [
	{
		label: 'Email',
		value: email,
		href: `mailto:${email}`,
		note: 'Best way to reach me',
	},
	{
		label: 'LinkedIn',
		value: 'linkedin.com/in/eugene-agyeman',
		href: 'https://www.linkedin.com/in/eugene-agyeman',
		note: 'Work and experience',
	},
	{
		label: 'GitHub',
		value: 'github.com/eugeneagyeman',
		href: 'https://github.com/eugeneagyeman',
		note: 'Side projects and experiments',
	},
	{
		label: 'Curriculum Vitae',
		value: 'See my CV',
		href: '/cv',
		note: 'Experience, projects, and skills',
	},
];

const icons = {
	Email: 'M2 6.5A2.5 2.5 0 014.5 4h15A2.5 2.5 0 0122 6.5v11a2.5 2.5 0 01-2.5 2.5h-15A2.5 2.5 0 012 17.5v-11zM4 6l8 6 8-6',
	LinkedIn:
		'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.03 0-2.34 1.58-2.34 3.21V21h-4V9z',
	GitHub:
		'M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0022 12 10 10 0 0012 2z',
	'Curriculum Vitae': 'M7 2h7l5 5v15a1 1 0 01-1 1H7a1 1 0 01-1-1V3a1 1 0 011-1zm7 1.5V7h3.5M9 13h6M9 17h6',
};
---

<Layout
	title="Contact | Eugene Agyeman"
	description="Get in touch with Eugene Agyeman, a software engineer in London. Email, LinkedIn, and GitHub."
>
	<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-24">
		<div class="max-w-2xl">
			<p class="text-sm font-semibold tracking-wide text-white/95 dark:text-cyan-500 mb-3">
				Contact
			</p>
			<h1
				class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white dark:text-white leading-[1.1]"
			>
				Say hello.
			</h1>
			<p class="mt-6 text-lg text-white/90 dark:text-slate-400 leading-relaxed">
				Questions, half-formed ideas, or just a chat about technology. I read everything that
				comes in.
			</p>
		</div>

		<ul class="mt-12 grid gap-4 sm:grid-cols-2">
			{
				channels.map((channel) => (
					<li>
						<a
							href={channel.href}
							target={channel.href.startsWith('http') ? '_blank' : undefined}
							rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
							class="group flex h-full items-start gap-4 rounded-2xl border border-white/25 bg-white/10 p-6 transition-colors hover:border-white/50 hover:bg-white/15"
						>
							<span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/15 text-white">
								<svg
									class="h-5 w-5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
									viewBox="0 0 24 24"
									aria-hidden="true"
								>
									<path d={icons[channel.label]} />
								</svg>
							</span>
							<span class="min-w-0">
								<span class="block text-xs font-semibold tracking-wide text-white/95">
									{channel.label}
								</span>
								<span class="mt-1 block font-medium text-white break-words group-hover:underline">
									{channel.value}
								</span>
								<span class="mt-1 block text-sm text-white/90 dark:text-slate-400">
									{channel.note}
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>
