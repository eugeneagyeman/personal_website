{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "personal-website",
	"compatibility_date": "2026-09-29",
	"workers_dev": false,
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
